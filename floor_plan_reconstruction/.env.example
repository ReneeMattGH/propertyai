# The portal this engine delivers finished worlds to. Use the deployed origin
# when the client site is hosted; use http://localhost:3000 for a fully local run.
CRESTION_PORTAL_URL=https://crestionlabs.vercel.app

# Shared HMAC key. Must equal PRODUCTION_BACKEND_SECRET on the portal. It signs
# submissions inbound, queue reads outbound and deliveries back.
PRODUCTION_BACKEND_SECRET=

# Browser origins allowed to call the engine. Both local sites are allowed out
# of the box; add the hosted studio origin when this engine serves one.
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002

# Extra hosts whose file links may be downloaded over plain HTTP, comma
# separated. The list only widens what is allowed: portal storage on
# *.supabase.co is always reachable, with or without this setting.
INTAKE_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000

# Where uploaded plans, generated scenes and job state are written. Point this
# at a persistent volume on a hosted deployment; it defaults to this directory.
REALESTAI_DATA_DIR=
